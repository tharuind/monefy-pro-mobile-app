rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function validCatalog(data, itemId, allowedKinds) {
      return data.keys().hasOnly([
          'id', 'kind', 'name', 'updatedAt', 'deletedAt', 'deviceId'
        ]) &&
        data.id == itemId &&
        data.kind in allowedKinds &&
        data.name is string && data.name.size() > 0 &&
        data.updatedAt is string &&
        (data.deletedAt == null || data.deletedAt is string) &&
        data.deviceId is string;
    }

    match /users/{userId} {
      allow read, write: if signedInAs(userId);

      match /transactions/{transactionId} {
        function validTransaction(data) {
          return data.keys().hasOnly([
              'id', 'cents', 'type', 'category', 'account', 'note',
              'date', 'updatedAt', 'deletedAt', 'deviceId'
            ]) &&
            data.id == transactionId &&
            data.cents is int && data.cents > 0 &&
            data.type in ['income', 'expense'] &&
            data.category is string && data.category.size() > 0 &&
            data.account is string && data.account.size() > 0 &&
            data.note is string &&
            data.date is string && data.updatedAt is string &&
            (data.deletedAt == null || data.deletedAt is string) &&
            data.deviceId is string;
        }
        allow read: if signedInAs(userId);
        allow create, update: if signedInAs(userId) &&
          validTransaction(request.resource.data);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if signedInAs(userId);
        allow create, update: if signedInAs(userId) &&
          validCatalog(request.resource.data, accountId, ['account']);
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if signedInAs(userId);
        allow create, update: if signedInAs(userId) &&
          validCatalog(request.resource.data, categoryId,
            ['expense_category', 'income_category']);
        allow delete: if false;
      }
    }
  }
}
